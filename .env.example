# BackDeck — пример переменных окружения (dev)
# Скопируй в .env и подставь свои значения
# ВНИМАНИЕ: порт 5433 (5432 занят локальным postgres на Mac)

# PostgreSQL (локальный запуск; в Docker для сервисов адрес postgres:5432)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/postgres

# JWT
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=60
